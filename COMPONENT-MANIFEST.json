      ],
      "controls": [
        "developer console"
      ]
    },
    "09-footer": {
      "name": "Global Public Footer",
      "runtime": "hoa-footer-runtime-v9.js",
      "owns": [
        "footer behavior contract"
      ],
      "protected_dom": [
        "#hoaFrontSocialFooter",
        "#hoaV653ConnectWrap",
        "#hoaProfessionalFooter"
      ],
      "consumes": [
        "navigation/public state"
      ],
      "controls": [
        "footer presentation/native-bottom mechanisms"
      ]
    },
    "10-header": {
      "name": "Header",
      "runtime": "hoa-header-runtime-v10.js",
      "owns": [
        "header behavior contract"
      ],
      "consumes": [
        "Navigation",
        "Authentication state"
      ],
      "controls": [
        "header presentation/navigation"
      ]
    },
    "11-regression": {
      "name": "Regression / Compatibility",
      "runtime": "hoa-regression-runtime-v11.js",
      "owns": [
        "backward-compatibility guards",
        "regression checks"
      ],
      "consumes": [
        "all established contracts"
      ],
      "controls": [
        "compatibility protections"
      ]
    },
    "12-release": {
      "name": "Release Guard",
      "runtime": "hoa-release-runtime-v12.js",
      "owns": [
        "release-time integrity checks"
      ],
      "consumes": [
        "component manifest",
        "protected contracts"
      ],
      "controls": [
        "release validation"
      ]
    }
  },
  "load_order": [
    "hoa-admin-runtime-v7.js",
    "hoa-auth-bootstrap-v3.js",
    "hoa-auth-runtime-v3.js",
    "hoa-authentication-adapter-v4.js",
    "hoa-component-bootstrap-v2.js",
    "hoa-component-registry.js",
    "hoa-component-runtime.js",
    "hoa-core-navigation-adapter-v3.js",
    "hoa-core-runtime-v2.js",
    "hoa-developer-runtime-v8.js",
    "hoa-exam-runtime-v5.js",
    "hoa-footer-runtime-v9.js",
    "hoa-free-student-portal-adapter-v6.js",
    "hoa-header-runtime-v10.js",
    "hoa-home-adapter-v5.js",
