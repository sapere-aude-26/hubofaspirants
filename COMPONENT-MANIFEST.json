    "hoa-paid-student-application-adapter-v7.js",
    "hoa-regression-runtime-v11.js",
    "hoa-release-runtime-v12.js",
    "hoa-result-runtime-v6.js",
    "hoa-student-auth-bootstrap-v4.js",
    "hoa-student-auth-bridge-v4.js"
  ],
  "protected_footer": [
    "#hoaFrontSocialFooter",
    "#hoaV653ConnectWrap",
    "#hoaProfessionalFooter"
  ],
  "rules": [
    "single Supabase infrastructure owner",
    "single authentication owner",
    "no duplicate footer DOM",
    "no header redesign in this migration",
    "production baseline retained for rollback",
    "component runtimes load in dependency order"
  ]
